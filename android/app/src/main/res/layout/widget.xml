<?xml version="1.0" encoding="utf-8"?>
<!-- Her widget, as calls in her game: your last words with her (hers red on the left, yours green on the right) on
     the home screen as it is (no background), and under them, on the right, MSG over her name in a red call box,
     to write to her -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/widget_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical" />

    <!-- MSG over the call box, from its left, as CALL in her game -->
    <LinearLayout
        android:id="@+id/widget_write"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:text="MSG"
            android:textColor="#FFE8392D"
            android:textSize="16.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:src="@drawable/widget_msg_bar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_msg_frame"
                android:gravity="center_vertical"
                android:minWidth="112dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="22dp"
                    android:src="@drawable/widget_msg_icon" />

                <TextView
                    android:id="@+id/widget_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Capri"
                    android:textColor="#FFE8392D"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
