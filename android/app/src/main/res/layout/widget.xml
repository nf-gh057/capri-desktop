<?xml version="1.0" encoding="utf-8"?>
<!-- Her widget, as calls in her game: your words with her (hers on the left, yours on the right, each in a see-through
     bubble with a neon outline, in her style's colours) on the home screen as it is (no background), and along the
     bottom edge her HUD bar: ornaments on the left, the call and message buttons on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- as many as the widget's height lets in, the newest at the bottom; older ones above, with a finger (Android
         12+), the topmost fading out while there are more above it -->

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:fadingEdgeLength="48dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <!-- (Android 11: the last ones, as they are, from the bottom) -->
    <LinearLayout
        android:id="@+id/widget_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- her HUD bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:id="@+id/widget_bar"
        android:background="@drawable/hud_frame"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="18dp"
            android:id="@+id/widget_glyphs"
            android:src="@drawable/widget_bar_glyphs" />

        <!-- how many PCs of your swarm answer: LNK//02 -->
        <TextView
            android:id="@+id/widget_lnk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.1"
            android:text="LNK//--"
            android:textColor="@color/her_deep"
            android:textSize="10sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_call"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_call"
            android:src="@drawable/widget_btn_call" />

        <ImageView
            android:id="@+id/widget_write"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_write"
            android:src="@drawable/widget_btn_msg" />
    </LinearLayout>
</LinearLayout>
